{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["bun"],
    "lib": ["ESNext", "DOM", "DOM.Iterable"]
  },
  "files": [
    "src/core/licensing-client/contract.ts",
    "src/core/licensing-client/identity.ts",
    "src/core/licensing-client/links.ts",
    "src/core/licensing-client/transport.ts",
    "tests/licensing-client/identity.test.ts",
    "tests/licensing-client/transport.test.ts",
    "src/workflow/asset-contract.ts",
    "src/workflow/asset-bundle.ts",
    "src/core/redaction.ts",
    "src/core/licence/mask.ts",
    "src/core/licence/workflow.ts",
    "src/workflow/errors.ts",
    "tests/workflow/asset-bundle.test.ts"
  ]
}
