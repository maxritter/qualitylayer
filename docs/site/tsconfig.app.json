{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "esnext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    // The site's tests read repository files with Node's own modules.
    "types": ["node"],

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitAny": false,
    "noFallthroughCasesInSwitch": false,

    "paths": {
      // Files outside the site (the docs' search landmark) resolve React from here.
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "marked": ["./node_modules/marked"],
      // The shared-artifact files the site follows live under qualitylayer/, where only the App's own install
      // resolves these; the site job installs just its own dependencies.
      "css-tree": ["./node_modules/@types/css-tree"],
      "parse5": ["./node_modules/parse5"],
      "dompurify": ["./node_modules/dompurify"],
      "cn": ["./node_modules/cn"],
      "lucide-react": ["./node_modules/lucide-react"],
      "@base-ui/react/*": ["./node_modules/@base-ui/react/*"],
      "@/*": ["./src/*"],
      "@ql/*": ["../../qualitylayer/src/*"]
    }
  },
  "include": ["src"]
}
