{
  "name": "qualitylayer",
  "version": "12.6.0",
  "private": true,
  "type": "module",
  "qualitylayer": {
    "recordedTree": {
      "schema": 1,
      "outputs": ["dist", "src/server/ui"],
      "producers": {
        "bun run build": ["dist", "src/server/ui"],
        "bun run test": ["dist", "src/server/ui"],
        "bun run test:smoke": ["dist", "src/server/ui"],
        "bun run test:beta": ["dist", "src/server/ui"],
        "bun run test --all": ["dist", "src/server/ui"],
        "bun run test:ui": ["dist", "src/server/ui"],
        "bun run test:ui --all": ["dist", "src/server/ui"]
      },
      "tools": ["cargo", "rustc", "cc"]
    }
  },
  "imports": {
    "#workflow": {
      "sealed": "./src/workflow/sealed.ts",
      "default": "./src/workflow/assets.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "perf:check": "bun scripts/performance/run.ts",
    "perf:heap": "bun scripts/performance/run.ts --heap",
    "agent:check": "bun scripts/agent-checks.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "deadcode": "knip",
    "test": "bun run scripts/test.ts",
    "test:beta": "bun run scripts/test-beta.ts",
    "test:smoke": "bun run scripts/test.ts",
    "preflight": "bun run scripts/preflight.ts",
    "build": "bun run scripts/build.ts",
    "app:build": "bun run scripts/app.ts",
    "app:install": "bun run scripts/app-install.ts",
    "app:dev": "bun run scripts/app.ts --run",
    "dev:ui": "bun run scripts/ui-dev.ts",
    "test:ui": "bun scripts/ui-built.ts",
    "test:ui:headed": "bun scripts/ui-built.ts --headed",
    "install:local": "bun run scripts/install-local.ts",
    "app:icon": "bun run scripts/app-icon.ts",
    "check:cockpit": "bun scripts/check-cockpit.ts --build --test-build",
    "check:overflow": "bun scripts/check-overflow.ts",
    "check:models": "bun scripts/check-models.ts",
    "dev:cli": "bun run scripts/dev-cli.ts",
    "dev:models": "bun artifacts/app/serve.ts",
    "dev:skill": "bun run scripts/dev-skill.ts",
    "release-gate": "bun run tests/release/run-agent.ts",
    "bench": "bun run tests/release/bench.ts",
    "person-test": "bun run tests/release/person-session.ts",
    "beta-smoke": "bun run tests/release/beta-smoke.ts",
    "evals": "bun run tests/release/evals.ts",
    "eval:activation": "bun run tests/release/activation.ts",
    "proof:docker": "bun run tests/proof/docker/run.ts",
    "proof:done-means": "bun run tests/release/done-means.ts",
    "proof:team-agents": "bun run tests/release/team-agents.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "1.64.0",
    "@tailwindcss/cli": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16",
    "@types/bun": "1.4.2",
    "@types/css-tree": "3.2.0",
    "@types/react": "19",
    "@types/react-dom": "19",
    "happy-dom": "21.0.4",
    "next": "16.4.2",
    "javascript-obfuscator": "5.8.0",
    "knip": "6.38.0",
    "onnxruntime-web": "1.30.0",
    "shadcn": "4.22.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": "1.32.0",
    "lodash-es": "4.18.1",
    "dompurify": "3.4.17",
    "next": "16.4.2",
    "source-map-js": "1.2.2",
    "body-parser@^2.0.0": "2.4.0",
    "undici@^6.0.0": "6.29.1",
    "undici@^7.0.0": "7.30.1",
    "zod@^4.0.0": "4.6.6"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@clack/prompts": "1.8.1",
    "@fontsource/noto-emoji": "5.3.2",
    "@fontsource/noto-sans-math": "5.3.0",
    "@fontsource/noto-sans-symbols": "5.3.0",
    "@fontsource/noto-sans-symbols-2": "5.3.0",
    "@happy-dom/global-registrator": "21.0.4",
    "@pierre/diffs": "1.5.2",
    "@tanstack/react-virtual": "3.14.12",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "css-tree": "3.2.1",
    "dompurify": "3.4.17",
    "geist": "1.7.2",
    "grok-mermaid": "0.2.3",
    "lucide-react": "1.48.0",
    "marked": "18.0.14",
    "mermaid": "12.0.0",
    "parse5": "8.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "restty": "0.3.0",
    "sonner": "2.0.8"
  },
  "patchedDependencies": {
    "@xterm/addon-webgl@0.19.0": "patches/@xterm%2Faddon-webgl@0.19.0.patch",
    "@xterm/xterm@6.0.0": "patches/@xterm%2Fxterm@6.0.0.patch"
  }
}
