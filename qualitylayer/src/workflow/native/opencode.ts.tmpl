import { spawn } from "node:child_process"
import { readFileSync, realpathSync, statSync } from "node:fs"
import { isAbsolute } from "node:path"
import { Plugin } from "@opencode/plugin"
import { peerBridge } from "./peers.js"

const BIN = "{{QUALITYLAYER_BIN}}"
const MEMORY_TOOLS: { name: string; description: string; inputSchema: object }[] = "{{MEMORY_TOOLS}}" as any
// True in the copy an App launch carries in its own config directory. That launch sets
// QUALITYLAYER_SESSION_HOOKS to "opencode", and the installed copy then steps aside so no event is
// reported twice.
const LAUNCH: boolean = "{{QUALITYLAYER_LAUNCH}}" as any

// The helper's brief: `brief` as text, or `brief_file`, the path QualityLayer wrote it to, read here so the
// lead session never carries the text. The file must be a .md file in `briefs/` of a task runtime
// (`projects/<id>/tasks/<slug>/briefs/`) or of a managed run (`runs/<id>/briefs/`).
function briefText(input: any): string {
  const text = typeof input.brief === "string" && input.brief !== ""
  const file = typeof input.brief_file === "string" && input.brief_file !== ""
  if (text === file) throw new Error("Pass exactly one of brief or brief_file")
  if (text) return input.brief
  if (!isAbsolute(input.brief_file)) throw new Error("brief_file must be an absolute path")
  let real: string, body: string
  try {
    real = realpathSync(input.brief_file)
    const stat = statSync(real)
    if (!stat.isFile() || stat.size > 1048576) throw new Error("unreadable")
    body = readFileSync(real, "utf8")
  } catch { throw new Error("brief_file is not a readable file") }
  const parts = real.split(/[\\/]/), n = parts.length
  const filed = real.endsWith(".md") && parts[n - 2] === "briefs" &&
    ((parts[n - 4] === "tasks" && parts[n - 6] === "projects") || parts[n - 4] === "runs")
  if (!filed) throw new Error("brief_file must be a .md file in the briefs folder of a QualityLayer task")
  if (!body.trim()) throw new Error("brief_file is empty")
  return body
}

export default Plugin.define({
  id: "qualitylayer",
  async setup(ctx: any) {
    if (!LAUNCH && process.env.QUALITYLAYER_SESSION_HOOKS === "opencode") return
    await ctx.provider?.transform?.((editor: any) => {
      if (!editor.get("ollama")) return
      editor.update("ollama", (provider: any) => {
        if (Object.hasOwn(provider.settings ?? {}, "headerTimeout")) return
        provider.settings = { ...provider.settings, headerTimeout: 900_000 }
      })
    })
    async function sessionModel(selected: string, effort?: string) {
      const [providerID, ...parts] = selected.split("/")
      const [id, explicit] = parts.join("/").split("#")
      if (!providerID || !id) throw new Error("QualityLayer needs a provider/model for OpenCode")
      const variant = effort || explicit
      if (!variant) return { providerID, id }
      const catalog = await ctx.model.list({ location: { directory: ctx.location.directory } })
      const model = catalog.data.find((item: any) => item.providerID === providerID && item.id === id)
      return model?.variants.some((item: any) => item.id === variant) ? { providerID, id, variant } : { providerID, id }
    }
    const controller = new AbortController()
    const pending = new Map<string, string>()
    const pickerCompletions = new Set<Promise<void>>()
    const compacting = new Map<string, Promise<string>>()
    const active = new Set<string>()
    const interrupted = new Set<string>()
    const configured = new Set<string>()
    const peers = new Map<string, any>()
    const peerOrigin = new Set<string>()
    const helperSessions = new Set<string>()
    const childSessions = new Set<string>()
    const runningHelpers = new Set<string>()
    const knownSessions = new Map<string, any>()
    const remember = (set: Set<string>, value: string) => { set.add(value); if (set.size > 512) set.delete(set.values().next().value) }
    const readOnly = process.env.QUALITYLAYER_REVIEW_READ_ONLY === "1"
    const readTools = new Set(["read", "glob", "grep", "list", "ls", "webfetch", "websearch", "codesearch", "memory_search", "memory_read"])
    if (readOnly) await ctx.tool.transform((editor: any) => {
      for (const tool of editor.list()) if (!readTools.has(tool.id)) editor.remove(tool.id)
    })
    if (!readOnly) await ctx.tool.transform((editor: any) => {
      editor.add({
        name: "ql_helper",
        description: "Run one QualityLayer helper in a fresh native child session. Pass the `brief_file` path returned by QualityLayer (or, without a file, the complete brief as `brief`), with its model and effort.",
        input: { type: "object", properties: { brief: { type: "string" }, brief_file: { type: "string" }, model: { type: "string" }, effort: { type: "string", enum: ["low", "medium", "high", "xhigh"] }, minutes: { type: "number", minimum: 1, maximum: 30 } }, additionalProperties: false },
        options: { codemode: false },
        async execute(input: any, tool: any) {
          if (helperSessions.has(tool.sessionID)) throw new Error("A helper cannot start another helper")
          const brief = briefText(input)
          const parent = await ctx.session.get({ sessionID: tool.sessionID })
          let model = parent.model
          if (input.model) model = await sessionModel(input.model, input.effort)
          else if (model && input.effort) model = await sessionModel(`${model.providerID}/${model.id}`, input.effort)
          const session = await ctx.session.create({ parentID: tool.sessionID, title: "QualityLayer helper", agent: "build", metadata: { qualitylayerHelper: true }, ...(model ? { model } : {}) })
          remember(helperSessions, session.id)
          remember(childSessions, session.id)
          remember(configured, session.id)
          runningHelpers.add(session.id)
          const deadline = new AbortController()
          const timer = setTimeout(() => deadline.abort(), (input.minutes || 20) * 60_000)
          const signal = AbortSignal.any([tool.signal, deadline.signal])
          const interrupt = () => { void ctx.session.interrupt({ sessionID: session.id }).catch(() => {}) }
          signal.addEventListener("abort", interrupt, { once: true })
          try {
            if (signal.aborted) throw new Error("Helper interrupted")
            await ctx.session.prompt({ sessionID: session.id, text: brief, metadata: { qualitylayerContinuation: true } }, { signal })
            await ctx.session.wait({ sessionID: session.id }, { signal })
            if (signal.aborted) throw new Error("Helper interrupted")
            const messages = await ctx.session.context({ sessionID: session.id }, { signal })
            const answer = [...messages].reverse().find((message: any) => message.type === "assistant" && message.content?.some((part: any) => part.type === "text" && part.text))
            const text = answer?.content.filter((part: any) => part.type === "text").map((part: any) => part.text).join("\n")
            if (!text) throw new Error("The helper returned no final text")
            return { content: text.slice(-65536), metadata: { sessionID: session.id, model, effort: model?.variant } }
          } finally {
            clearTimeout(timer)
            signal.removeEventListener("abort", interrupt)
            if (signal.aborted) await ctx.session.interrupt({ sessionID: session.id }).catch(() => {})
            runningHelpers.delete(session.id)
          }
        },
      })
    })
    // The lesson tools: the schemas are the binary's own, and each call runs `memory tool <name> --json`.
    await ctx.tool.transform((editor: any) => {
      for (const tool of MEMORY_TOOLS) editor.add({
        name: tool.name,
        description: tool.description,
        input: tool.inputSchema,
        options: { codemode: false },
        async execute(input: any, call: any) {
          if (tool.name === "memory_save" && readOnly) throw new Error("Reviewers do not save lessons")
          if (tool.name === "memory_keep" && readOnly) throw new Error("Reviewers do not keep lessons")
          const { output, code } = await run(call.sessionID, ["memory", "tool", tool.name, "--json"], JSON.stringify(input ?? {}), 30_000, call.signal)
          let row: any
          try { row = JSON.parse(output) } catch { throw new Error(code === null ? "The lesson tool did not finish" : "The lesson tool returned no JSON") }
          if (row.ok === false) throw new Error(row.error?.message || "The lesson tool failed")
          return { content: output, metadata: {} }
        },
      })
    })
    // One call to the binary for a session: `input` on its stdin, its stdout back, and its exit code
    // (null when it could not start, ran out of time or was stopped).
    function run(session: string, args: string[], input: string, limit: number, signal?: AbortSignal): Promise<{ output: string; code: number | null }> {
      if (!/^[A-Za-z0-9_-]{1,128}$/.test(session)) return Promise.resolve({ output: "", code: null })
      return new Promise((resolve) => {
        let output = "", settled = false
        const child = spawn(BIN, LAUNCH && args[0] === "hook" ? [...args, "--launch"] : args, {
          cwd: ctx.location.directory,
          env: { ...process.env, QUALITYLAYER_AGENT: "opencode", QUALITYLAYER_NATIVE_PID: String(process.pid), OPENCODE_SESSION_ID: session },
          stdio: ["pipe", "pipe", "ignore"], windowsHide: true,
        })
        const stop = () => child.kill()
        const finish = (code: number | null) => { if (!settled) { settled = true; clearTimeout(timer); signal?.removeEventListener("abort", stop); resolve({ output, code }) } }
        const timer = setTimeout(() => { child.kill(); finish(null) }, limit)
        child.on("error", () => finish(null))
        child.stdout.on("data", (chunk) => { if (output.length < 262144) output += chunk.toString() })
        child.on("close", (code) => finish(code))
        child.stdin.on("error", () => {})
        child.stdin.end(input)
        signal?.addEventListener("abort", stop, { once: true })
        if (signal?.aborted) stop()
      })
    }
    async function hook(session: string, kind: string, event: string, extra: object = {}): Promise<string> {
      const payload = { session_id: session, cwd: ctx.location.directory, agent_pid: process.pid, hook_event_name: event, ...extra }
      return (await run(session, ["hook", kind], JSON.stringify(payload), 5000)).output.slice(0, 65536)
    }
    // A permission OpenCode asks about may be answered in QualityLayer's Conversation view while the person
    // looks at the session. The binary prints nothing unless the view shows it, and OpenCode's own prompt
    // stays in charge: this runs beside it, never holds it, and stops when it is answered there.
    const asking = new Map<string, { controller: AbortController; sessionID: string }>()
    async function rootSession(sessionID: string): Promise<string> {
      let id = sessionID
      for (let depth = 0; depth < 4; depth++) {
        let session = knownSessions.get(id)
        if (!session) {
          try { session = await ctx.session.get({ sessionID: id }) } catch { break }
          knownSessions.set(id, session)
        }
        if (!session?.parentID) break
        id = session.parentID
      }
      return id
    }
    function answer(output: string): { behavior: string; scope?: string; message?: string } | null {
      for (const line of output.split("\n")) {
        try {
          const row = JSON.parse(line)
          if (row && (row.behavior === "allow" || row.behavior === "deny")) return row
        } catch { /* Not the answer. */ }
      }
      return null
    }
    async function askView(request: any): Promise<void> {
      if (asking.size >= 16 || asking.has(request.id)) return
      const waiter = new AbortController()
      asking.set(request.id, { controller: waiter, sessionID: request.sessionID })
      try {
        const root = await rootSession(request.sessionID)
        const payload = { session_id: root, cwd: ctx.location.directory, hook_event_name: "PermissionRequest", tool_name: request.action, tool_use_id: request.source?.id, tool_input: { ...request.metadata, resources: request.resources } }
        const { output } = await run(root, ["hook", "approve", "--agent", "opencode"], JSON.stringify(payload), 560_000, waiter.signal)
        const decision = waiter.signal.aborted ? null : answer(output)
        if (!decision) return
        const message = typeof decision.message === "string" && decision.message ? { message: decision.message } : {}
        await ctx.permission.reply({ sessionID: request.sessionID, requestID: request.id, decision: decision.behavior === "deny" ? "reject" : decision.scope === "session" ? "always" : "once", ...message })
      } catch { /* OpenCode asks in its own window. */ }
      finally { asking.delete(request.id) }
    }
    function context(output: string): string {
      return output.split("\n").flatMap((line) => {
        try { const row = JSON.parse(line); return [row.hookSpecificOutput?.additionalContext, row.reason].filter((x) => typeof x === "string") }
        catch { return line.trim() ? [line] : [] }
      }).join("\n")
    }
    await ctx.session.hook("prompt", async (event: any) => {
      if (!knownSessions.has(event.sessionID)) {
        const session = await ctx.session.get({ sessionID: event.sessionID })
        knownSessions.set(event.sessionID, session)
        if (knownSessions.size > 512) knownSessions.delete(knownSessions.keys().next().value)
        if (session.parentID) remember(childSessions, session.id)
        if (session.metadata?.qualitylayerHelper === true) remember(helperSessions, session.id)
      }
      if (!readOnly && !childSessions.has(event.sessionID) && !peers.has(event.sessionID)) {
        const bridge = await peerBridge(BIN, "opencode", event.sessionID, ctx.location.directory, async (text: string) => { await ctx.session.prompt({ sessionID: event.sessionID, text, delivery: "queue" }) })
        peers.set(event.sessionID, bridge)
      }
      const bridge = peers.get(event.sessionID)
      const peer = bridge?.consume(event.prompt.text) === true
      const human = !peer && event.metadata?.qualitylayerContinuation !== true
      if (peer) peerOrigin.add(event.sessionID)
      else if (human) peerOrigin.delete(event.sessionID)
      await bridge?.state("busy", human)
      const selected = process.env.QUALITYLAYER_OPENCODE_MODEL
      if (!childSessions.has(event.sessionID) && !configured.has(event.sessionID)) {
        const agent = process.env.QUALITYLAYER_OPENCODE_AGENT
        if (agent) await ctx.session.switchAgent({ sessionID: event.sessionID, agent })
        if (selected) {
          const model = await sessionModel(selected, process.env.QUALITYLAYER_OPENCODE_EFFORT)
          await ctx.session.switchModel({ sessionID: event.sessionID, model })
        }
        if (selected || agent) remember(configured, event.sessionID)
      }
      await hook(event.sessionID, "live", "SessionStart")
      const text = context(await hook(event.sessionID, "prompt", "UserPromptSubmit", { prompt: event.prompt.text }))
      if (text) pending.set(event.sessionID, [pending.get(event.sessionID), text].filter(Boolean).join("\n"))
    })
    await ctx.session.hook("context", async (event: any) => {
      if (helperSessions.has(event.sessionID)) { delete event.tools.ql_helper; delete event.tools.task }
      const text = pending.get(event.sessionID)
      if (text) { event.system.push({ type: "text", text }); pending.delete(event.sessionID) }
      // After a compaction the next model call carries the project lessons again; any other call
      // returns without asking the binary.
      const marked = compacting.get(event.sessionID)
      if (marked) {
        compacting.delete(event.sessionID)
        await marked
        const block = (await hook(event.sessionID, "memory-compact", "ContextRequest")).trim()
        if (block) event.system.push({ type: "text", text: block })
      }
    })
    await ctx.tool.hook("execute.before", async (event: any) => {
      if (readOnly && !readTools.has(event.tool)) throw new Error("QualityLayer reviewers can only inspect files.")
      if (event.tool === "question") {
        const output = await hook(event.sessionID, "ask", "PreToolUse", { tool_name: "question", tool_use_id: event.id, tool_input: event.input })
        for (const line of output.split("\n")) {
          let decision: any
          try { decision = JSON.parse(line).hookSpecificOutput } catch { continue }
          if (decision?.permissionDecision === "deny") throw new Error(decision.permissionDecisionReason || "Use QualityLayer's App for this question.")
        }
      }
      // Answers the person gave in the App reach the agent with its next tool call, as they do in Claude Code.
      const answers = context(await hook(event.sessionID, "live", "PreToolUse", { tool_name: event.tool, tool_use_id: event.id, tool_input: event.input }))
      if (answers) pending.set(event.sessionID, [pending.get(event.sessionID), answers].filter(Boolean).join("\n").slice(-65536))
    })
    await ctx.tool.hook("execute.after", async (event: any) => {
      const text = context(await hook(event.sessionID, "activity", "PostToolUse", { tool_name: event.tool, tool_use_id: event.id, tool_input: event.input, tool_response: event.result ?? event.output, is_error: event.status ? event.status !== "completed" : Boolean(event.error) }))
      if (text) pending.set(event.sessionID, [pending.get(event.sessionID), text].filter(Boolean).join("\n").slice(-65536))
      if (event.tool === "question" && !event.error && pickerCompletions.size < 4) {
        const completion = hook(event.sessionID, "picker", "PostToolUse", { tool_name: event.tool, tool_use_id: event.id, tool_input: event.input, tool_response: event.output })
          .then((output) => { const text = context(output); if (text) pending.set(event.sessionID, [pending.get(event.sessionID), text].filter(Boolean).join("\n").slice(-65536)) })
          .catch(() => {}).finally(() => pickerCompletions.delete(completion))
        pickerCompletions.add(completion)
      }
    })
    await ctx.shell.hook("create.before", (event: any) => {
      const session = event.env.OPENCODE_SESSION_ID
      event.env.QUALITYLAYER_PEER_ORIGIN = peerOrigin.has(session) ? "1" : "0"
      event.env.QUALITYLAYER_AGENT = "opencode"
      event.env.QUALITYLAYER_NATIVE_PID = String(process.pid)
    })
    await ctx.permission.hook("evaluate", async (event: any) => {
      if (event.effect === "ask" && process.env.QUALITYLAYER_OPENCODE_PERMISSION === "fewer") event.effect = "allow"
      if (event.effect === "ask") await hook(event.sessionID, "live", "PermissionRequest")
    })
    void (async () => {
      try {
        for await (const event of ctx.event.subscribe({ signal: controller.signal })) {
          if (event.type === "session.deleted") {
            const id = event.data.sessionID
            for (const waiting of asking.values()) if (waiting.sessionID === id) waiting.controller.abort()
            await peers.get(id)?.close(); peers.delete(id); peerOrigin.delete(id); helperSessions.delete(id); childSessions.delete(id); runningHelpers.delete(id); knownSessions.delete(id); pending.delete(id); compacting.delete(id); active.delete(id); interrupted.delete(id); configured.delete(id)
            continue
          }
          if (event.type === "permission.asked") { if (!readOnly) void askView(event.data); continue }
          if (event.type === "permission.replied") { asking.get(event.data.requestID)?.controller.abort(); continue }
          // A question OpenCode asks is the person's turn, like a permission.
          if (event.type === "question.asked") {
            if (!readOnly && typeof event.data?.sessionID === "string") void hook(event.data.sessionID, "live", "Notification", { notification_type: "permission_prompt", message: "OpenCode asks a question" }).catch(() => {})
            continue
          }
          if (event.type === "session.compacted") { compacting.set(event.data.sessionID, hook(event.data.sessionID, "memory-compact", "PreCompact")); continue }
          if (event.type === "session.execution.interrupted") { remember(interrupted, event.data.sessionID); continue }
          if (event.type !== "session.status") continue
          const { sessionID, status } = event.data
          if (status.type === "busy") { active.add(sessionID); interrupted.delete(sessionID); continue }
          if (status.type !== "idle" || !active.delete(sessionID)) continue
          const aborted = interrupted.delete(sessionID)
          await peers.get(sessionID)?.state("idle")
          const output = await hook(sessionID, "stop", "Stop", aborted ? { reason: "interrupted" } : {})
          if (!aborted) {
            const advisory = output.split("\n").flatMap((line) => {
              try { const row = JSON.parse(line); return typeof row.hookSpecificOutput?.additionalContext === "string" ? [row.hookSpecificOutput.additionalContext] : [] }
              catch { return [] }
            }).join("\n")
            if (advisory) pending.set(sessionID, [pending.get(sessionID), advisory].filter(Boolean).join("\n").slice(-65536))
          }
          if (aborted || helperSessions.has(sessionID)) continue
          for (const line of output.split("\n")) {
            try {
              const row = JSON.parse(line)
              if (row.decision === "block" && typeof row.reason === "string") {
                await ctx.session.prompt({ sessionID, text: row.reason, delivery: "queue", metadata: { qualitylayerContinuation: true } })
                break
              }
            } catch { /* A diagnostic is not a continuation request. */ }
          }
        }
      } catch { /* Closing the private native server also closes this subscription. */ }
    })()
    return async () => { await Promise.allSettled([...pickerCompletions]); controller.abort(); for (const waiting of asking.values()) waiting.controller.abort(); asking.clear(); await Promise.allSettled([...runningHelpers].map((sessionID) => ctx.session.interrupt({ sessionID }))); await Promise.allSettled([...peers.values()].map((bridge) => bridge.close())); peers.clear(); peerOrigin.clear(); helperSessions.clear(); childSessions.clear(); runningHelpers.clear(); knownSessions.clear(); pending.clear(); compacting.clear(); active.clear(); interrupted.clear(); configured.clear() }
  },
})
